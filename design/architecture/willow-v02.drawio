<mxfile host="app.diagrams.net" modified="2026-07-20T21:45:00Z" agent="willow" version="24.0.0">
  <diagram id="willow-target" name="Willow target architecture v0.2">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="legend" value="&lt;b&gt;Willow v0.2 — Sean's v0.1 topology, status-checked against live wiring 2026-07-20&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;green = live today&lt;/font&gt; · &lt;font color=&quot;#b97700&quot;&gt;amber = partial / split across old+new&lt;/font&gt; · &lt;font color=&quot;#c62828&quot;&gt;red = not built yet&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="700" height="40" as="geometry"/>
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="&lt;b&gt;User (operator)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- External projects -->
        <mxCell id="ext" value="&lt;b&gt;External Projects&lt;/b&gt;&lt;br&gt;upstream desk: hermes, redential,&lt;br&gt;ctxvault, basic-memory, …&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ live (upstream_watcher)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Gate -->
        <mxCell id="gate" value="&lt;b&gt;Gate — SSH · PGP · egress permissions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;✓ pgp_enforced · Kart egress = 3 keys&lt;br&gt;(cap + consent + operator lease)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ envelope registry ↔ sandbox drift known&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="300" height="90" as="geometry"/>
        </mxCell>

        <!-- Willow seat -->
        <mxCell id="seat" value="&lt;b&gt;Willow&lt;/b&gt;&lt;br&gt;persona + folder for orchestration&lt;br&gt;via CLI &lt;font color=&quot;#2e7d32&quot;&gt;✓&lt;/font&gt; or Dashboard &lt;font color=&quot;#c62828&quot;&gt;✗ not built&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- willow-mcp hub -->
        <mxCell id="hub" value="&lt;b&gt;willow-mcp — the hub&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b97700&quot;&gt;◐ mounted by charter seat only today;&lt;br&gt;22/23 seats still on legacy unified server.&lt;br&gt;Full hub = the decommission build (awaits ratify)&lt;/font&gt;" style="shape=mxgraph.flowchart.direct_data;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
