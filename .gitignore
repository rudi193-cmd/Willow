# Project-local Willow runtime (schema tracked under soil/ and .willow/project.json)
.willow/store/
.willow/store/**/*.db
.willow/active-agent

# Local IDE / operator overlays (materialize via willow-mcp: willow-mcp project sync willow
# or ./willow.sh project sync willow when willow-mcp is installed)
.cursor/settings.local.json
.cursor/hooks.json
.cursor/mcp.json
.mcp.json
.claude/settings.local.json
.codex/

# Envelope registry backups (never commit)
envelopes/pre-approved.json.bak*
design/architecture/.$*.bkp
__pycache__/
