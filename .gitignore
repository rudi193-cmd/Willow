.cursor/*
!.cursor/rules/
!.cursor/rules/**
.mcp.json
.claude/settings.local.json
.codex/

# Envelope registry backups (never commit)
envelopes/pre-approved.json.bak*
design/architecture/.$*.bkp
__pycache__/

# Local Nestor dogfood DB (not charter state)
/data/
