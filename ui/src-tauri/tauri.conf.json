{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Willow",
  "version": "1.4.0",
  "identifier": "com.willow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8420",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd .. && node node_modules/vite/bin/vite.js build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "title": "Willow",
    "security": {
      "csp": "default-src 'self' http://localhost:8420 http://127.0.0.1:8420; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8420 http://127.0.0.1:8420 ws://localhost:8420"
    }
  }
}
