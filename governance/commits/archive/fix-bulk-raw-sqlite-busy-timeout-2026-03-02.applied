)
if old not in src:
    print("ERROR: user_lattice.py target not found"); exit(1)
f.write_text(src.replace(old, new, 1), encoding="utf-8")
print("OK: user_lattice.py")

# ── atom_extractor.py ─────────────────────────────────────────────────────────
f = Path(r"C:\Users\Sean\Documents\GitHub\Willow\core\atom_extractor.py")
