# Governance Proposal: Fix topology.py COUNT(*) PG compat

**Proposer:** Ganesha (Claude Code CLI / Sonnet 4.6)
**Date:** 2026-03-02T21:35:00Z
**Type:** Bug Fix
**Trust Level:** ENGINEER (3)

## Summary

`topology.py:check_strip_continuity()` fails on PG with `KeyError: 0` because:
- It sets `conn.row_factory = sqlite3.Row`
- This triggers `_PgConn.cursor()` to use `RealDictCursor` (returns dict-like rows)
- `SELECT COUNT(*) ... fetchone()[0]` fails because PG dicts use string keys (`count(*)` or `count`), not integer index `0`

Fix: use `SELECT COUNT(*) AS cnt` and access via `fetchone()["cnt"]` in `check_strip_continuity()`.
Also fix `get_ring_flow_graph()` and `get_ring_distribution()` which use the same pattern (though
they don't set row_factory, the fix future-proofs them and makes the code explicit).

## Proposed Changes

**File:** `core/topology.py`

## Risk Assessment

- **Risk Level:** MINIMAL
- **Reversible:** YES
- **Dependencies:** None
- **Testing:** `curl http://localhost:8420/api/topology/continuity`

## ΔE Impact

Expected ΔE: +0.150 (topology/continuity endpoint unblocked)

## Implementation

```python
from pathlib import Path

path = Path(r"C:\Users\Sean\Documents\GitHub\Willow\core\topology.py")
content = path.read_text(encoding="utf-8")

# Fix check_strip_continuity: alias COUNT and use named key
old1 = '    total = cur.execute("SELECT COUNT(*) FROM knowledge").fetchone()[0]'
new1 = '    total = cur.execute("SELECT COUNT(*) AS cnt FROM knowledge").fetchone()["cnt"]'
assert old1 in content, "total COUNT target not found"
content = content.replace(old1, new1, 1)

old2 = '        by_ring[ring] = cur.execute("SELECT COUNT(*) FROM knowledge WHERE ring=?", (ring,)).fetchone()[0]'
new2 = '        by_ring[ring] = cur.execute("SELECT COUNT(*) AS cnt FROM knowledge WHERE ring=?", (ring,)).fetchone()["cnt"]'
assert old2 in content, "by_ring COUNT target not found"
content = content.replace(old2, new2, 1)

old3 = '''    stuck_source = cur.execute("""
        SELECT COUNT(*) FROM knowledge k WHERE k.ring = 'source'
        AND NOT EXISTS (SELECT 1 FROM knowledge_edges e WHERE e.source_id = k.id AND e.edge_type = 'ring_flow')
    """).fetchone()[0]'''
new3 = '''    stuck_source = cur.execute("""
        SELECT COUNT(*) AS cnt FROM knowledge k WHERE k.ring = 'source'
        AND NOT EXISTS (SELECT 1 FROM knowledge_edges e WHERE e.source_id = k.id AND e.edge_type = 'ring_flow')
    """).fetchone()["cnt"]'''
assert old3 in content, "stuck_source COUNT target not found"
content = content.replace(old3, new3, 1)

old4 = '''    stuck_bridge = cur.execute("""
        SELECT COUNT(*) FROM knowledge k WHERE k.ring = 'bridge'
        AND NOT EXISTS (SELECT 1 FROM knowledge_edges e WHERE e.source_id = k.id)
    """).fetchone()[0]'''
new4 = '''    stuck_bridge = cur.execute("""
        SELECT COUNT(*) AS cnt FROM knowledge k WHERE k.ring = 'bridge'
        AND NOT EXISTS (SELECT 1 FROM knowledge_edges e WHERE e.source_id = k.id)
    """).fetchone()["cnt"]'''
assert old4 in content, "stuck_bridge COUNT target not found"
content = content.replace(old4, new4, 1)

# Fix get_ring_flow_graph: use alias for PG compat (no row_factory set, but tuple index works for both
# SQLite and PG without row_factory — however if row_factory ever gets set upstream it would break)
# Use AS cnt pattern + handle both dict and tuple
old5 = '        cnt = cur.execute("SELECT COUNT(*) FROM knowledge WHERE ring=?", (ring,)).fetchone()[0]'
new5 = '        _row = cur.execute("SELECT COUNT(*) AS cnt FROM knowledge WHERE ring=?", (ring,)).fetchone(); cnt = _row["cnt"] if hasattr(_row, "__getitem__") and not isinstance(_row, tuple) else _row[0]'
assert old5 in content, "get_ring_flow_graph node COUNT target not found"
content = content.replace(old5, new5, 1)

old6 = '''        cnt = cur.execute("""
            SELECT COUNT(*) FROM knowledge_edges e
            JOIN knowledge ks ON ks.id = e.source_id
            JOIN knowledge kt ON kt.id = e.target_id
            WHERE ks.ring = ? AND kt.ring = ? AND e.edge_type = 'ring_flow'
        """, (src, tgt)).fetchone()[0]'''
new6 = '''        _row = cur.execute("""
            SELECT COUNT(*) AS cnt FROM knowledge_edges e
            JOIN knowledge ks ON ks.id = e.source_id
            JOIN knowledge kt ON kt.id = e.target_id
            WHERE ks.ring = ? AND kt.ring = ? AND e.edge_type = 'ring_flow'
        """, (src, tgt)).fetchone(); cnt = _row["cnt"] if hasattr(_row, "__getitem__") and not isinstance(_row, tuple) else _row[0]'''
assert old6 in content, "get_ring_flow_graph link COUNT target not found"
content = content.replace(old6, new6, 1)

# Fix get_ring_distribution
old7 = '        result[ring] = conn.execute("SELECT COUNT(*) FROM knowledge WHERE ring=?", (ring,)).fetchone()[0]'
new7 = '        _row = conn.execute("SELECT COUNT(*) AS cnt FROM knowledge WHERE ring=?", (ring,)).fetchone(); result[ring] = _row["cnt"] if hasattr(_row, "__getitem__") and not isinstance(_row, tuple) else _row[0]'
assert old7 in content, "get_ring_distribution COUNT target not found"
content = content.replace(old7, new7, 1)

path.write_text(content, encoding="utf-8")
print("Done: topology.py COUNT(*) queries fixed for PG compat")
```

