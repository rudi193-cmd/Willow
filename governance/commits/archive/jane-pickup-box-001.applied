### Change 3 — JavaScript (before closing `</script>` tag, ~line 803)

```diff
--- a/web/jane.html
+++ b/web/jane.html
@@ -802,6 +802,64 @@
+    // ── Pickup Box ────────────────────────────────────────────
+    const WILLOW_API = 'http://localhost:8420';
+
+    async function loadPickup() {
+      try {
+        const res = await fetch(`${WILLOW_API}/api/pickup?username=Sweet-Pea-Rudi19`);
+        if (!res.ok) return;
+        const data = await res.json();
+        const items = data.items || [];
+        const list  = document.getElementById('pickup-list');
+        const badge = document.getElementById('pickup-badge');
+
+        badge.textContent = items.length;
+        badge.className = items.length > 0 ? 'pickup-badge' : 'pickup-badge zero';
+
+        if (items.length === 0) {
+          list.innerHTML = '<span class="pickup-empty">Empty</span>';
+          return;
+        }
+        list.innerHTML = items.map(item => `
+          <div class="pickup-item">
+            <span class="pickup-item-dismiss" onclick="dismissPickup('${encodeURIComponent(item.filename)}', this)">✕</span>
+            <div class="pickup-item-name" onclick="openPickupItem('${encodeURIComponent(item.filename)}')" style="cursor:pointer">${item.filename}</div>
+            <div class="pickup-item-preview">${item.preview || ''}</div>
+          </div>
+        `).join('');
+      } catch (e) {
+        // Willow offline — pickup silently unavailable
+      }
+    }
+
+    async function openPickupItem(encodedName) {
+      const filename = decodeURIComponent(encodedName);
+      try {
+        const res = await fetch(`${WILLOW_API}/api/pickup?username=Sweet-Pea-Rudi19`);
+        const data = await res.json();
+        const item = (data.items || []).find(i => i.filename === filename);
+        if (item && item.preview) {
+          appendMessage('jane', `[${item.filename}]\n\n${item.preview}`);
+        }
+      } catch (e) {}
+    }
+
+    async function dismissPickup(encodedName, el) {
+      const filename = decodeURIComponent(encodedName);
+      try {
+        await fetch(`${WILLOW_API}/api/pickup/${filename}?username=Sweet-Pea-Rudi19`, { method: 'DELETE' });
+        el.closest('.pickup-item').remove();
+        loadPickup();
+      } catch (e) {
+        el.closest('.pickup-item').remove();
+      }
+    }
+
+    // Poll pickup every 30s
+    setInterval(loadPickup, 30000);
+    loadPickup();

     showScreen('consent');
   </script>
```

## Rationale

- Closes the loop between Willow's Pickup system and the Jane public interface
- Badge visible pre-consent so the user knows items are waiting before authorizing
- Silent fallback if Willow is offline — no errors surfaced to the user
- Matches existing `.sidebar-section` / `.sidebar-section-title` design language exactly
- Polls every 30s (lightweight); DELETE cleans up server-side and re-syncs the list

## Risk Assessment

- **Risk Level:** LOW
- **Reversible:** YES — removing the three hunks fully reverts the feature
- **Dependencies:** Willow server running at `http://localhost:8420` with `/api/pickup` endpoint
- **Testing:** Load jane.html, open DevTools Network tab, verify 30s polling requests; drop a file in Pickup and confirm badge increments

## ΔE Impact

Expected ΔE: +0.012 (small, additive UI feature; no changes to consent flow or data model)

